<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>BrilliantQuesting.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/Saves/schema-*.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/BrilliantQuesting.Core/BrilliantQuesting.Core.csproj" />
    <!-- Exercise the actual native mount/rollback policy against a headless Window double.
         Native widget rendering still requires Elin; these tests do not emulate Unity layout. -->
    <Compile Include="../../src/BrilliantQuesting.Plugin/NativeJournalSurface.cs" Link="NativeJournalSurface.cs" />
    <EmbeddedResource Include="../../src/BrilliantQuesting.Plugin/NativeJournalRenderer.cs" LogicalName="JournalRendererSource" />
    <EmbeddedResource Include="../../src/BrilliantQuesting.Core/Presentation/JournalPages.cs" LogicalName="JournalPagesSource" />
  </ItemGroup>

</Project>
