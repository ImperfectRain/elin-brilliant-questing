    {
      "id": "fragments.modifiers.relationship",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "mod.tie.stranger.trust.first",
            "position": "modifier",
            "text": "You are asking for trust before introducing a reason.",
            "requires": {
              "relationship": "none"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.stranger.not.well.enough",
            "position": "modifier",
            "text": "I do not know you well enough for that answer.",
            "requires": {
              "relationship": "none"
            },
            "repetitionGroup": "tie"
          },
          {
            "id": "mod.tie.stranger.earn.the.second",
            "position": "modifier",
            "text": "Start with your name. Then earn the second question.",
            "requires": {
              "relationship": "none"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.acquaintance.past.introductions",
            "position": "modifier",
            "text": "We are past introductions, not yet at confessions.",
            "requires": {
              "relationship": "acquaintance"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.acquaintance.listen",
            "position": "modifier",
            "text": "I know you well enough to listen.",
            "requires": {
              "relationship": "acquaintance"
            },
            "repetitionGroup": "tie"
          },
          {
            "id": "mod.tie.friend.disagree.after",
            "position": "modifier",
            "text": "I can disagree with you after I help.",
            "requires": {
              "relationship": "friend"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.friend.saves.us.finding.some",
            "position": "modifier",
            "text": "This sounds like trouble. I suppose that saves us finding some.",
            "requires": {
              "relationship": "friend"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.friend.came.on.purpose",
            "position": "modifier",
            "text": "Do not give me that look. You came here on purpose.",
            "requires": {
              "relationship": [
                "friend",
                "family"
              ]
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.family.already.dislike",
            "position": "modifier",
            "text": "Whatever you are about to ask, I already dislike who made you ask it.",
            "requires": {
              "relationship": [
                "family",
                "spouse"
              ]
            },
            "repetitionGroup": "tie",
            "memorability": "protected"
          },
          {
            "id": "mod.tie.family.no.strangers",
            "position": "modifier",
            "text": "Do not make me pretend we are strangers.",
            "requires": {
              "relationship": [
                "family",
                "spouse",
                "friend"
              ]
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.rival.without.liking",
            "position": "modifier",
            "text": "I can do this without liking you.",
            "requires": {
              "relationship": "rival"
            },
            "repetitionGroup": "tie"
          },
          {
            "id": "mod.tie.rival.prefer.it.be.me",
            "position": "modifier",
            "text": "If anyone ruins you, I would prefer it be me.",
            "requires": {
              "relationship": "rival"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.enemy.watching.what.i.say",
            "position": "modifier",
            "text": "I am watching what I say around you.",
            "requires": {
              "relationship": "enemy"
            },
            "tone": [
              "cold"
            ],
            "repetitionGroup": "tie",
            "memorability": "voiced"
          },
          {
            "id": "mod.tie.enemy.remember.what.you.did",
            "position": "modifier",
            "text": "I remember what you did. Apparently you do not.",
            "requires": {
              "relationship": "enemy"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.creditor.not.disappeared",
            "position": "modifier",
            "text": "The debt between us did not disappear because you became desperate.",
            "requires": {
              "relationship": "debtor"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.creditor.something.useful",
            "position": "modifier",
            "text": "At last, something useful to do with your obligation.",
            "requires": {
              "relationship": "debtor"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.debtor.not.forgotten",
            "position": "modifier",
            "text": "I have not forgotten what you did for me.",
            "requires": {
              "relationship": "creditor"
            },
            "repetitionGroup": "tie"
          },
          {
            "id": "mod.tie.debtor.inconvenient",
            "position": "modifier",
            "text": "This is the part where an old favour becomes inconvenient.",
            "requires": {
              "relationship": "creditor"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.employer.do.the.work",
            "position": "modifier",
            "text": "Do the work and we will discuss the rest afterward.",
            "requires": {
              "relationship": "employee"
            },
            "repetitionGroup": "tie",
            "memorability": "voiced"
          },
          {
            "id": "mod.tie.employee.your.position",
            "position": "modifier",
            "text": "I understand your position. The facts remain inconvenient.",
            "requires": {
              "relationship": "employer"
            },
            "tone": [
              "formal"
            ],
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.guildmate.answers.in.a.hall",
            "position": "modifier",
            "text": "There are answers one gives differently in a hall like this.",
            "requires": {
              "relationship": "guild_mate"
            },
            "tone": [
              "formal"
            ],
            "repetitionGroup": "tie",
            "memorability": "signature"
          },
          {
            "id": "mod.tie.accomplice.both.of.us",
            "position": "modifier",
            "text": "Whatever lands on you lands on me. Remember that.",
            "requires": {
              "relationship": "accomplice"
            },
            "repetitionGroup": "tie",
            "memorability": "signature"
          }
        ]
      }
    },
    {
      "id": "fragments.modifiers",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "mod.answer.stand.behind",
            "position": "modifier",
            "text": "I will stand behind that.",
            "requires": {
              "act": "answer",
              "commitment": "committed"
            },
            "repetitionGroup": "commitment"
          },
          {
            "id": "mod.answer.could.be.wrong",
            "position": "modifier",
            "text": "Though I could have it wrong.",
            "requires": {
              "act": "answer",
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment"
          },
          {
            "id": "mod.answer.would.swear",
            "position": "modifier",
            "text": "I would swear to it.",
            "requires": {
              "act": [
                "answer",
                "accuse",
                "inform"
              ],
              "commitment": "committed"
            },
            "repetitionGroup": "commitment"
          },
          {
            "id": "mod.answer.not.the.house",
            "position": "modifier",
            "text": "I would bet on it. I would not bet the house.",
            "requires": {
              "act": [
                "answer",
                "inform"
              ],
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.best.explanation",
            "position": "modifier",
            "text": "It is the best explanation I have.",
            "requires": {
              "act": [
                "answer",
                "inform"
              ],
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment",
            "memorability": "voiced"
          },
          {
            "id": "mod.answer.leave.room",
            "position": "modifier",
            "text": "My memory says yes. My caution says leave room.",
            "requires": {
              "act": "answer",
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.no.receipt",
            "position": "modifier",
            "text": "The truth was careless enough to leave no receipt.",
            "requires": {
              "act": [
                "answer",
                "accuse"
              ],
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.only.my.word",
            "position": "modifier",
            "text": "All I have is my word.",
            "requires": {
              "act": [
                "answer",
                "accuse"
              ],
              "commitment": "hedged"
            },
            "repetitionGroup": "commitment"
          },
          {
            "id": "mod.answer.held.back",
            "position": "modifier",
            "text": "That is as much as I will say.",
            "requires": {
              "act": "answer",
              "held_back": "yes"
            },
            "repetitionGroup": "reserve"
          },
          {
            "id": "mod.answer.know.more",
            "position": "modifier",
            "text": "I know more than I am saying.",
            "requires": {
              "act": [
                "answer",
                "inform"
              ],
              "held_back": "yes"
            },
            "repetitionGroup": "reserve",
            "memorability": "voiced"
          },
          {
            "id": "mod.answer.would.cost.someone",
            "position": "modifier",
            "text": "The rest would cost somebody.",
            "requires": {
              "act": [
                "answer",
                "refuse"
              ],
              "held_back": "yes"
            },
            "repetitionGroup": "reserve",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.cost",
            "position": "modifier",
            "text": "It is not worth what it would cost me.",
            "requires": {
              "act": "refuse"
            },
            "repetitionGroup": "reserve"
          },
          {
            "id": "mod.evade.said.enough",
            "position": "modifier",
            "text": "I have said all I mean to.",
