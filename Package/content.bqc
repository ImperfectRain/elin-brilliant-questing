                "inform"
              ]
            },
            "tags": [
              "cultivation"
            ],
            "repetitionGroup": "flavour",
            "memorability": "voiced"
          },
          {
            "id": "mod.promise.cultivation.weather",
            "position": "modifier",
            "text": "I can promise the work. I cannot promise the weather.",
