    {
      "id": "fragments.context",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "ctx.many.ears",
            "position": "context",
            "text": "Not with this many ears about.",
            "requires": {
              "audience": "several"
            },
            "repetitionGroup": "context.setting"
          },
          {
            "id": "ctx.between.us",
            "position": "context",
