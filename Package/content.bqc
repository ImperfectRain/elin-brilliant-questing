            ],
            "repetitionGroup": "flavour"
          },
          {
            "id": "mod.answer.craft.strain",
            "position": "modifier",
            "text": "Strain never shows at the surface. It shows at the joint.",
            "requires": {
              "act": [
                "answer",
                "inform",
                "accuse"
              ]
            },
            "tags": [
              "craft"
            ],
            "repetitionGroup": "flavour"
          },
          {
            "id": "mod.offer.craft.twice",
            "position": "modifier",
