            },
            "repetitionGroup": "reserve"
          },
          {
            "id": "mod.answer.ask.carefully",
            "position": "modifier",
            "text": "Ask carefully.",
            "requires": {
              "act": [
                "answer",
                "evade"
              ],
              "held_back": "yes"
            },
            "repetitionGroup": "reserve",
            "memorability": "voiced"
          },
          {
            "id": "mod.deny.believe",
            "position": "modifier",
            "text": "You can believe that or not.",
