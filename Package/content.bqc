              "depth": "in_confidence",
              "commitment": "committed"
            },
            "repetitionGroup": "accuse.evidence",
            "memorability": "signature"
          },
          {
            "id": "core.accuse.anger.say.the.name",
            "position": "core",
            "text": "Say their name again. I want to hear whether it still sounds harmless.",
            "requires": {
              "act": "accuse",
              "emotion": "anger"
            },
            "repetitionGroup": "accuse.mood",
            "memorability": "signature"
          },
          {
            "id": "core.accuse.public.witnesses",
            "position": "core",
            "text": "Good. We have witnesses. It was {referent}.",
            "requires": {
              "act": "accuse",
              "audience": "several"
            },
            "repetitionGroup": "accuse.mood",
            "memorability": "voiced"
          },
          {
            "id": "core.accuse.public.carefully",
            "position": "core",
            "text": "I will say this where it can be repeated. {referent} took it.",
            "requires": {
