            "id": "open.greet.employer",
            "position": "opener",
            "text": "You are paying, so ask.",
            "requires": {
              "relationship": "employer"
            },
            "repetitionGroup": "greeting",
            "memorability": "voiced"
          },
          {
            "id": "open.mood.anger.short",
            "position": "opener",
            "text": "Make it worth the interruption.",
            "requires": {
              "emotion": "anger"
            },
            "tone": [
              "curt"
            ],
            "repetitionGroup": "greeting.mood",
            "memorability": "voiced"
          },
          {
            "id": "open.mood.fear.quiet",
            "position": "opener",
            "text": "Keep your voice down.",
            "requires": {
              "emotion": "fear"
            },
            "repetitionGroup": "greeting.mood"
          },
          {
            "id": "open.mood.grief.today",
            "position": "opener",
            "text": "Not a good day for it.",
            "requires": {
              "emotion": "grief"
            },
            "repetitionGroup": "greeting.mood",
            "memorability": "protected"
          },
          {
            "id": "open.mood.stress.furniture",
            "position": "opener",
            "text": "If another person asks me for something I may become furniture.",
            "requires": {
              "emotion": "stress"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "greeting.mood",
            "memorability": "signature"
          },
          {
            "id": "open.mood.relief.enough.for.now",
            "position": "opener",
            "text": "Good. That is enough for now.",
            "requires": {
              "emotion": "relief"
            },
            "repetitionGroup": "greeting.mood"
          },
          {
            "id": "open.mood.suspicion.interesting",
            "position": "opener",
            "text": "Interesting.",
            "requires": {
              "emotion": "suspicion"
            },
            "repetitionGroup": "greeting.mood"
          },
          {
            "id": "open.mood.affection.good.cup",
            "position": "opener",
            "text": "I saved the good cup. Do not make that embarrassing.",
            "requires": {
              "emotion": "affection",
              "audience": "one"
            },
            "repetitionGroup": "greeting.mood",
            "memorability": "protected"
          },
          {
            "id": "open.mood.shame.rather.not",
            "position": "opener",
            "text": "I know why you are here.",
            "requires": {
              "emotion": "shame"
            },
            "repetitionGroup": "greeting.mood",
            "memorability": "voiced"
          }
        ]
      }
    },
    {
      "id": "fragments.vocabulary",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "mod.refuse.cultivation",
            "position": "modifier",
            "text": "Some things need their season, and I am not rushing this one.",
            "requires": {
              "act": "refuse"
            },
            "tags": [
              "cultivation"
            ],
            "repetitionGroup": "reserve",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.alchemy",
            "position": "modifier",
            "text": "Not everything mixes well, and this will not either.",
            "requires": {
              "act": "refuse"
            },
            "tags": [
              "alchemy"
            ],
            "repetitionGroup": "reserve",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.craft",
            "position": "modifier",
            "text": "I do not hand over work before it is fit to be seen.",
            "requires": {
              "act": "refuse"
            },
            "tags": [
              "craft"
            ],
            "repetitionGroup": "reserve",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.trade",
            "position": "modifier",
            "text": "That is not a bargain I am making.",
            "requires": {
              "act": "refuse"
            },
            "tags": [
              "trade"
            ],
            "repetitionGroup": "reserve"
          },
          {
            "id": "mod.refuse.public_order",
            "position": "modifier",
            "text": "That is not mine to hand over.",
            "requires": {
              "act": "refuse"
            },
            "tags": [
              "public_order"
            ],
            "repetitionGroup": "reserve"
          },
          {
            "id": "mod.answer.cultivation.soil",
            "position": "modifier",
            "text": "Ground tells you more than people do.",
            "requires": {
              "act": [
                "answer",
                "inform"
              ]
            },
            "tags": [
              "cultivation"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.alchemy.measures",
            "position": "modifier",
            "text": "I measure things for a living. I noticed.",
            "requires": {
              "act": [
                "answer",
                "inform",
                "accuse"
              ]
            },
            "tags": [
              "alchemy"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.craft.hands",
            "position": "modifier",
            "text": "You can tell a great deal from what a thing was carried in.",
            "requires": {
              "act": [
                "answer",
                "inform"
              ]
            },
            "tags": [
              "craft"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.trade.ledger",
            "position": "modifier",
            "text": "It did not balance. That is how I know.",
            "requires": {
              "act": [
                "answer",
                "inform",
                "accuse"
              ]
            },
            "tags": [
              "trade"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          },
          {
            "id": "mod.answer.public_order.seen.it.before",
            "position": "modifier",
            "text": "I have seen this shape of trouble before.",
            "requires": {
              "act": [
                "answer",
                "inform",
                "warn"
              ]
            },
            "tags": [
              "public_order"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          },
          {
            "id": "mod.offer.trade.terms",
            "position": "modifier",
            "text": "Terms first. Then handshakes.",
            "requires": {
              "act": "offer"
            },
            "tags": [
              "trade"
            ],
            "repetitionGroup": "flavour",
            "memorability": "voiced"
          },
          {
            "id": "mod.warn.public_order.badge.limits",
            "position": "modifier",
            "text": "My office lets me ask. It does not let me invent proof.",
            "requires": {
              "act": [
                "warn",
                "refuse",
                "answer"
              ]
            },
            "tags": [
              "public_order"
            ],
            "repetitionGroup": "flavour",
            "memorability": "signature"
          }
        ]
      }
    },
