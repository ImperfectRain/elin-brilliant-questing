    {
      "id": "fragments.core.denial",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "core.deny.flat",
            "position": "core",
            "text": "No. That is not what happened.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.wrong",
            "position": "core",
            "text": "Whoever told you that has it wrong.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.not.me",
            "position": "core",
            "text": "It was not me.",
