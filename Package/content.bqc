            "memorability": "voiced"
          },
          {
            "id": "mod.boundary.not.leverage",
            "position": "modifier",
            "text": "You may ask about me. You do not get to use {subject} as leverage.",
            "requires": {
              "act": [
                "refuse",
                "deny"
              ]
            },
            "repetitionGroup": "boundary",
            "memorability": "signature"
          },
          {
            "id": "mod.boundary.unreasonable.about.family",
            "position": "modifier",
            "text": "I become unreasonable where family is concerned. Plan accordingly.",
            "requires": {
              "act": [
                "refuse",
                "threaten",
                "warn"
              ]
            },
            "repetitionGroup": "boundary",
            "memorability": "signature"
          },
          {
            "id": "mod.boundary.quarrel.not.inherited",
