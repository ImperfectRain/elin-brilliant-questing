            "text": "I think it was {referent}.",
            "requires": {
              "act": "accuse",
              "commitment": "hedged"
            },
            "repetitionGroup": "accuse.standing"
          },
          {
            "id": "core.accuse.not.certain.waited",
            "position": "core",
            "text": "If I am wrong I ruin them. If I am right I have already waited too long.",
            "requires": {
              "act": "accuse",
              "commitment": "hedged"
            },
            "repetitionGroup": "accuse.standing",
            "memorability": "protected"
          },
          {
            "id": "core.accuse.can.prove",
            "position": "core",
            "text": "I can prove it, and it was {referent}.",
            "requires": {
