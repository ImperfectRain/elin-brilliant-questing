              "act": "accuse"
            },
            "repetitionGroup": "stubborn"
          },
          {
            "id": "mod.accuse.title.no.difference",
            "position": "modifier",
            "text": "A title does not change what happened.",
            "requires": {
              "act": [
                "accuse",
                "deny"
              ],
              "audience": "several"
            },
            "repetitionGroup": "stubborn",
            "memorability": "signature"
          },
          {
            "id": "mod.deny.not.there.anyway",
            "position": "modifier",
            "text": "You may outrank me. You were still not there.",
            "requires": {
              "act": [
                "deny",
                "answer"
              ]
            },
            "repetitionGroup": "stubborn",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.edge.of.willing",
            "position": "modifier",
            "text": "That is the edge of what I am willing to become for this.",
            "requires": {
              "act": [
                "refuse",
                "deny"
              ]
            },
            "repetitionGroup": "stubborn",
            "memorability": "signature"
          },
          {
            "id": "mod.refuse.will.not.lie",
            "position": "modifier",
