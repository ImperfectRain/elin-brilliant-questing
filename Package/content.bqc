              "act": "ask"
            },
            "repetitionGroup": "ask"
          },
          {
            "id": "core.ask.what.happened",
            "position": "core",
            "text": "What happened?",
            "requires": {
              "act": "ask"
            },
            "repetitionGroup": "ask"
          },
          {
            "id": "core.ask.tell.me.saw",
            "position": "core",
            "text": "Tell me what you saw.",
            "requires": {
              "act": "ask"
            },
            "repetitionGroup": "ask"
          },
          {
            "id": "core.ask.stopped.making.sense",
