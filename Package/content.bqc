              "act": "accuse",
              "depth": [
                "detail",
                "in_confidence"
              ],
              "commitment": "committed"
            },
            "repetitionGroup": "accuse.evidence"
          },
          {
            "id": "core.accuse.trust.the.evidence",
            "position": "core",
            "text": "Do not trust my face. Trust what I can show you.",
