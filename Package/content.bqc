            "id": "core.warn.quiet.not.safe",
            "position": "core",
            "text": "Quiet is not the same as safe.",
            "requires": {
              "act": "warn"
            },
            "repetitionGroup": "warn",
            "memorability": "signature"
          },
          {
            "id": "core.warn.beyond.words",
            "position": "core",
            "text": "This has moved past words. Dress for that.",
            "requires": {
              "act": "warn"
            },
            "repetitionGroup": "warn",
            "memorability": "signature"
          },
          {
            "id": "core.warn.name.damaged",
            "position": "core",
            "text": "A name can be damaged faster than it can be repaired.",
            "requires": {
              "act": "warn"
            },
            "repetitionGroup": "warn.social",
            "memorability": "signature"
          },
          {
            "id": "core.warn.town.remembers",
            "position": "core",
            "text": "The town will remember the accusation longer than the correction.",
            "requires": {
              "act": "warn",
              "audience": "several"
            },
            "repetitionGroup": "warn.social",
            "memorability": "signature"
          },
          {
            "id": "core.warn.money.at.stake",
            "position": "core",
            "text": "Somebody loses money if this goes badly.",
            "requires": {
              "act": "warn"
            },
            "repetitionGroup": "warn.social"
          },
          {
            "id": "core.warn.livelihood",
            "position": "core",
            "text": "If this fails they lose the place.",
            "requires": {
              "act": "warn"
            },
            "repetitionGroup": "warn.social",
            "memorability": "voiced"
          },
          {
            "id": "core.warn.fear.checked.the.door",
            "position": "core",
            "text": "I have checked that door three times since you arrived.",
            "requires": {
              "act": "warn",
              "emotion": "fear"
            },
            "repetitionGroup": "warn.mood",
            "memorability": "signature"
          },
          {
            "id": "core.warn.affection.come.back",
            "position": "core",
            "text": "Come back safe.",
            "requires": {
              "act": "warn",
              "emotion": "affection"
            },
            "repetitionGroup": "warn.mood",
            "memorability": "protected"
          },
          {
            "id": "core.warn.close.tie.take.the.coat",
            "position": "core",
            "text": "Take the coat. We can argue about it when you return.",
            "requires": {
              "act": "warn",
              "relationship": [
                "spouse",
                "family"
              ]
            },
            "repetitionGroup": "warn.tie",
            "memorability": "protected"
          },
          {
            "id": "core.warn.rival.look.at.the.tracks",
            "position": "core",
            "text": "You do not have to trust me. Look at the tracks before you choose.",
            "requires": {
              "act": "warn",
              "relationship": [
                "rival",
                "enemy"
              ]
            },
            "repetitionGroup": "warn.tie",
            "memorability": "signature"
          }
        ]
      }
    },
    {
      "id": "fragments.core.denial",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "core.deny.flat",
            "position": "core",
            "text": "No. That is not what happened.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.wrong",
            "position": "core",
            "text": "Whoever told you that has it wrong.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.wrong.person",
            "position": "core",
            "text": "You have the wrong person.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.not.me",
            "position": "core",
            "text": "It was not me.",
            "requires": {
              "act": "deny",
              "referent": "speaker"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.took.nothing",
            "position": "core",
            "text": "I never took anything.",
            "requires": {
              "act": "deny",
              "referent": "speaker",
              "claim_predicate": "stole"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.believe.what.you.like",
            "position": "core",
            "text": "Believe what you like. It was not me.",
            "requires": {
              "act": "deny",
              "referent": "speaker"
            },
            "repetitionGroup": "deny",
            "memorability": "voiced"
          },
          {
            "id": "core.deny.bad.information",
            "position": "core",
            "text": "You have been given bad information.",
            "requires": {
              "act": "deny"
            },
            "repetitionGroup": "deny"
          },
          {
            "id": "core.deny.more.interesting.person",
            "position": "core",
            "text": "Whoever put me there has confused me with a more interesting person.",
            "requires": {
              "act": "deny",
              "referent": "speaker"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "deny",
            "memorability": "signature"
          },
          {
            "id": "core.deny.other",
            "position": "core",
            "text": "{referent} did no such thing.",
            "requires": {
              "act": "deny",
              "referent": "other"
            },
            "repetitionGroup": "deny.defend"
          },
          {
            "id": "core.deny.was.with.me",
            "position": "core",
            "text": "{referent} was with me.",
            "requires": {
              "act": "deny",
              "referent": "other"
            },
            "repetitionGroup": "deny.defend"
          },
          {
            "id": "core.deny.two.places",
            "position": "core",
            "text": "Find a better story. This one has {referent} in two places at once.",
            "requires": {
              "act": "deny",
              "referent": "other"
            },
            "repetitionGroup": "deny.defend",
            "memorability": "signature"
          },
          {
            "id": "core.deny.could.not.have",
            "position": "core",
            "text": "You are accusing somebody who could not have done it.",
            "requires": {
              "act": "deny",
              "referent": "other"
            },
            "repetitionGroup": "deny.defend"
          },
          {
            "id": "core.deny.one.of.mine",
            "position": "core",
            "text": "Bring me proof. Until then you are speaking about one of mine.",
            "requires": {
              "act": "deny",
              "referent": "other",
              "relationship": [
                "family",
                "spouse",
                "friend"
              ]
            },
            "repetitionGroup": "deny.defend",
            "memorability": "signature"
          },
          {
            "id": "core.deny.rumor.grew",
            "position": "core",
            "text": "By breakfast there were two of them. By lunch one had wings.",
            "requires": {
              "act": "deny",
              "reply": "gossip"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "deny.rumor",
            "memorability": "signature"
          },
          {
            "id": "core.deny.rumor.told.one.person",
            "position": "core",
            "text": "I told one person what I saw. Apparently I saw a great deal more by evening.",
            "requires": {
              "act": "deny",
              "reply": "gossip"
            },
            "repetitionGroup": "deny.rumor",
            "memorability": "signature"
          },
          {
            "id": "core.deny.rumor.plain",
            "position": "core",
            "text": "That is not what happened, and you can say so.",
            "requires": {
              "act": "deny",
              "reply": "gossip"
            },
            "repetitionGroup": "deny.rumor"
          },
          {
            "id": "core.deny.fear.never.there",
            "position": "core",
            "text": "No. I was never there.",
            "requires": {
              "act": "deny",
              "emotion": "fear",
              "referent": "speaker"
            },
            "repetitionGroup": "deny.mood"
          },
          {
            "id": "core.deny.anger.finish.the.sentence",
            "position": "core",
            "text": "Finish that sentence and then leave.",
            "requires": {
              "act": "deny",
              "emotion": "anger"
            },
            "tone": [
              "curt"
            ],
            "repetitionGroup": "deny.mood",
            "memorability": "signature"
          },
          {
            "id": "core.deny.public.everyone.will.remember",
            "position": "core",
            "text": "Say it carefully. Everyone here will remember it.",
            "requires": {
              "act": "deny",
              "audience": "several"
            },
            "repetitionGroup": "deny.mood",
            "memorability": "signature"
          },
          {
            "id": "core.deny.public.prove.it",
            "position": "core",
            "text": "Prove it.",
            "requires": {
              "act": "deny",
              "audience": "several"
            },
            "tone": [
              "curt"
            ],
            "repetitionGroup": "deny.mood"
          },
          {
            "id": "core.deny.stranger.dont.know.you",
            "position": "core",
            "text": "I do not know you, and I did not do it.",
            "requires": {
              "act": "deny",
              "relationship": "none"
            },
            "repetitionGroup": "deny.tie"
          },
          {
            "id": "core.deny.pride.own.trade",
            "position": "core",
            "text": "Do not explain my own trade to me. It was not me.",
            "requires": {
              "act": "deny",
              "referent": "speaker"
            },
            "repetitionGroup": "deny.tie",
            "memorability": "voiced"
          }
        ]
      }
    },
    {
      "id": "fragments.core.gossip",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "core.gossip.heard.something",
            "position": "core",
            "text": "I heard something about {referent}.",
            "requires": {
              "act": "gossip"
            },
            "repetitionGroup": "gossip"
          },
          {
            "id": "core.gossip.people.talking",
            "position": "core",
            "text": "This may be nothing, but {referent} has people talking.",
            "requires": {
              "act": "gossip"
            },
            "repetitionGroup": "gossip"
          },
          {
            "id": "core.gossip.not.the.only.one",
            "position": "core",
            "text": "I cannot prove it, and I am not the only one who heard.",
            "requires": {
              "act": "gossip",
              "commitment": "hedged"
            },
            "repetitionGroup": "gossip"
          },
          {
            "id": "core.gossip.smoke.not.fire",
            "position": "core",
            "text": "Treat it as smoke rather than fire.",
            "requires": {
              "act": "gossip",
              "commitment": "hedged"
            },
            "repetitionGroup": "gossip",
            "memorability": "voiced"
          },
          {
            "id": "core.gossip.better.clothes",
            "position": "core",
            "text": "A rumour arrived before breakfast and already has better clothes.",
            "requires": {
              "act": "gossip"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "gossip",
            "memorability": "signature"
          },
          {
            "id": "core.gossip.theft.matter",
            "position": "core",
            "text": "They are saying {referent} took the {matter}.",
            "requires": {
              "act": "gossip",
              "claim_predicate": "stole"
            },
            "repetitionGroup": "gossip.theft"
          },
          {
            "id": "core.gossip.theft.pockets",
            "position": "core",
            "text": "Word is the {matter} left in {referent}'s pocket.",
            "requires": {
              "act": "gossip",
              "claim_predicate": "stole"
            },
            "repetitionGroup": "gossip.theft",
            "memorability": "voiced"
          },
          {
            "id": "core.gossip.public.everyone.knows",
            "position": "core",
            "text": "Everyone knows it by now.",
            "requires": {
              "act": "gossip",
              "audience": "several"
            },
            "repetitionGroup": "gossip.spread"
          },
          {
            "id": "core.gossip.private.between.us.two",
            "position": "core",
            "text": "You did not hear this from me.",
            "requires": {
              "act": "gossip",
              "audience": "one"
            },
            "repetitionGroup": "gossip.spread",
            "memorability": "voiced"
          },
          {
            "id": "core.gossip.suspicion.arrived.neatly",
            "position": "core",
            "text": "It arrived very neatly, that story.",
            "requires": {
              "act": "gossip",
              "emotion": "suspicion"
            },
            "repetitionGroup": "gossip.spread",
            "memorability": "signature"
          }
        ]
      }
    },
    {
      "id": "fragments.core.inform",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "core.inform.plain",
            "position": "core",
            "text": "You should know something.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform"
          },
          {
            "id": "core.inform.happened",
            "position": "core",
            "text": "Something happened, and you have not heard it yet.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform"
          },
          {
            "id": "core.inform.before.someone.else",
            "position": "core",
            "text": "Better you hear it from me.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.subject.named",
            "position": "core",
            "text": "It is about {subject}.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform"
          },
          {
            "id": "core.inform.theft.plain",
            "position": "core",
            "text": "{subject} took the {matter}.",
            "requires": {
              "act": "inform",
              "claim_predicate": "stole"
            },
            "repetitionGroup": "inform.theft"
          },
          {
            "id": "core.inform.theft.gone",
            "position": "core",
            "text": "The {matter} is gone, and I know whose hands it left in.",
            "requires": {
              "act": "inform",
              "claim_predicate": "stole",
              "commitment": "committed"
            },
            "repetitionGroup": "inform.theft",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.theft.saw",
            "position": "core",
            "text": "I saw {subject} with the {matter}.",
            "requires": {
              "act": "inform",
              "claim_predicate": "stole",
              "commitment": "committed"
            },
            "repetitionGroup": "inform.theft"
          },
          {
            "id": "core.inform.talking",
            "position": "core",
            "text": "People are talking about it.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform.aftermath"
          },
          {
            "id": "core.inform.travelled",
            "position": "core",
            "text": "That travelled farther than the person who did it.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform.aftermath",
            "memorability": "signature"
          },
          {
            "id": "core.inform.still.here",
            "position": "core",
            "text": "You left. Your name stayed to finish the conversation.",
            "requires": {
              "act": "inform",
              "audience": "one"
            },
            "repetitionGroup": "inform.aftermath",
            "memorability": "signature"
          },
          {
            "id": "core.inform.secret.something",
            "position": "core",
            "text": "There is something you do not know.",
            "requires": {
              "act": "inform",
              "depth": "in_confidence"
            },
            "repetitionGroup": "inform.reveal"
          },
          {
            "id": "core.inform.secret.long.enough",
            "position": "core",
            "text": "I have kept this quiet long enough.",
            "requires": {
              "act": "inform",
              "depth": "in_confidence"
            },
            "repetitionGroup": "inform.reveal",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.secret.heavier",
            "position": "core",
            "text": "The secret has become heavier than the consequences.",
            "requires": {
              "act": "inform",
              "depth": "in_confidence"
            },
            "repetitionGroup": "inform.reveal",
            "memorability": "signature"
          },
          {
            "id": "core.inform.rumor.wrong",
            "position": "core",
            "text": "That story is wrong.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform.correction"
          },
          {
            "id": "core.inform.rumor.better.ending",
            "position": "core",
            "text": "Somebody added a better ending than the truth had.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform.correction",
            "memorability": "signature"
          },
          {
            "id": "core.inform.rumor.first.part",
            "position": "core",
            "text": "The first part is true. The rest grew afterward.",
            "requires": {
              "act": "inform"
            },
            "repetitionGroup": "inform.correction",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.rumor.horns",
            "position": "core",
            "text": "The story has grown horns since I last heard it.",
            "requires": {
              "act": "inform"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "inform.correction",
            "memorability": "signature"
          },
          {
            "id": "core.inform.fear.quiet",
            "position": "core",
            "text": "Not loudly. But you need to know.",
            "requires": {
              "act": "inform",
              "emotion": "fear"
            },
            "repetitionGroup": "inform.mood"
          },
          {
            "id": "core.inform.relief.finally",
            "position": "core",
            "text": "Good news, for once.",
            "requires": {
              "act": "inform",
              "emotion": "relief"
            },
            "repetitionGroup": "inform.mood"
          },
          {
            "id": "core.inform.affection.came.to.tell.you",
            "position": "core",
            "text": "I came to tell you myself.",
            "requires": {
              "act": "inform",
              "emotion": "affection"
            },
            "repetitionGroup": "inform.mood",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.close.tie.ugly.part",
            "position": "core",
            "text": "You already know the ugly part. Here is the rest.",
            "requires": {
              "act": "inform",
              "relationship": [
                "friend",
                "family",
                "spouse"
              ]
            },
            "repetitionGroup": "inform.tie",
            "memorability": "voiced"
          },
          {
            "id": "core.inform.stranger.for.what.it.is.worth",
            "position": "core",
            "text": "For what it is worth to you.",
            "requires": {
              "act": "inform",
              "relationship": "none"
            },
            "repetitionGroup": "inform.tie"
          },
          {
            "id": "core.inform.creditor.ledger",
            "position": "core",
            "text": "The ledger has an opinion about this.",
            "requires": {
              "act": "inform",
              "relationship": "creditor"
            },
            "tone": [
              "wry"
            ],
            "repetitionGroup": "inform.tie",
            "memorability": "signature"
          }
        ]
      }
    },
    {
      "id": "fragments.core.question",
      "kind": "dialogueFragments",
      "payload": {
        "fragments": [
          {
            "id": "core.ask.plain",
            "position": "core",
            "text": "What do you know about it?",
