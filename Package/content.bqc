              "reply": "answer"
            },
            "repetitionGroup": "ask.provenance"
          },
          {
            "id": "core.ask.provenance.backward",
            "position": "core",
            "text": "Trace that answer backward for me.",
            "requires": {
              "act": "ask",
              "reply": "answer"
            },
            "repetitionGroup": "ask.provenance",
            "memorability": "voiced"
