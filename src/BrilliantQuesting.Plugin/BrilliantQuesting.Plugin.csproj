<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 matches what Elin's own bundled Scripting Kit targets, which is the safest
      thing to agree with on Unity 2021.3 / Mono.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>BrilliantQuesting.Plugin</RootNamespace>
    <AssemblyName>BrilliantQuesting.Plugin</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <AssemblySearchPaths>$(AssemblySearchPaths);{HintPathFromItem}</AssemblySearchPaths>

    <!--
      Game and BepInEx assemblies are referenced from a local, gitignored folder. They are not
      ours to redistribute, so this project cannot build on a machine that has not populated
      lib/ from its own Elin install - see docs/plugin-build.md.
    -->
    <ElinLib Condition="'$(ElinLib)' == ''">$(MSBuildThisFileDirectory)..\..\lib\Elin</ElinLib>
    <BepInExLib Condition="'$(BepInExLib)' == ''">$(MSBuildThisFileDirectory)..\..\lib\BepInEx\BepInEx\core</BepInExLib>
    <ContentRoot Condition="'$(ContentRoot)' == ''">$(MSBuildThisFileDirectory)..\..\content</ContentRoot>
    <ContentBundlePath Condition="'$(ContentBundlePath)' == ''">$(MSBuildThisFileDirectory)..\..\Package\content.bqc</ContentBundlePath>
  </PropertyGroup>

  <Target Name="CheckElinReferences" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ElinLib)\Elin.dll')"
           Text="Elin.dll not found at $(ElinLib). Copy the assemblies listed in docs/plugin-build.md out of your own Elin install, or set the ElinLib property." />
    <Error Condition="!Exists('$(BepInExLib)\BepInEx.Core.dll')"
           Text="BepInEx.Core.dll not found at $(BepInExLib). See docs/plugin-build.md." />
  </Target>

  <Target Name="CheckContentBundle" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\tools\ContentCompiler\ContentCompiler.csproj&quot; -- --content &quot;$(ContentRoot)&quot; --output &quot;$(ContentBundlePath)&quot; --check" />
  </Target>

  <ItemGroup>
    <!--
      The simulation is compiled INTO this assembly rather than referenced beside it.

      Elin's Package Chainloader scans a package folder for BepInPlugin types; if enumerating them
      needs a sibling assembly it does not resolve, the type load fails and the package reports
      zero plugins with no error. Every working example in Package/ ships a single DLL, so this
      one does too. The Core project still exists as its own project - that is what the 100 tests
      build against, and it is still forbidden from referencing Elin.
    -->
    <Compile Include="..\BrilliantQuesting.Core\**\*.cs" Exclude="..\BrilliantQuesting.Core\bin\**\*.cs;..\BrilliantQuesting.Core\obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: these ship with the game, and must never be copied next to the plugin. -->
    <Reference Include="Elin">
      <HintPath>$(ElinLib)\Elin.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins.BaseCore">
      <HintPath>$(ElinLib)\Plugins.BaseCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins.Modding">
      <HintPath>$(ElinLib)\Plugins.Modding.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins.UI">
      <HintPath>$(ElinLib)\Plugins.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ships with the game; needed only because GameIOContext's signatures mention it. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ElinLib)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ElinLib)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ElinLib)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ElinLib)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExLib)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity">
      <HintPath>$(BepInExLib)\BepInEx.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExLib)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="package.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(ContentBundlePath)" Link="content.bqc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
